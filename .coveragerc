[run]
source = .
omit =
    tests/*
    */tests/*
    conftest.py
    test_*.py
    docs/*
    notebooks/*
    graphify-out/*
    scripts/*
    # live NSE website client (cookie-primed HTTP session against nseindia.com endpoints); every method is a network call
    nse_data_fetcher.py

[report]
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
