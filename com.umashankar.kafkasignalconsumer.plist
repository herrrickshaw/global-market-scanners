<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd service for kafka_signal_consumer.py — consumes stream_pipeline.py's
  `scan.signals` topic. Same persistence model as homebrew.mxcl.cassandra.plist
  / homebrew.mxcl.kafka.plist, instead of a manually-started process.

  Install / reload:
    cp com.umashankar.kafkasignalconsumer.plist ~/Library/LaunchAgents/
    launchctl bootout   gui/$(id -u)/com.umashankar.kafkasignalconsumer 2>/dev/null
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.umashankar.kafkasignalconsumer.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.umashankar.kafkasignalconsumer</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/umashankar/Downloads/code/python_files/.venv_eu/bin/python3</string>
    <string>/Users/umashankar/repos/global-market-scanners/kafka_signal_consumer.py</string>
    <string>--window</string>
    <string>5</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/umashankar/repos/global-market-scanners</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/umashankar/repos/global-market-scanners/kafka_signal_consumer.log</string>
  <key>StandardErrorPath</key><string>/Users/umashankar/repos/global-market-scanners/kafka_signal_consumer.err.log</string>
</dict>
</plist>
